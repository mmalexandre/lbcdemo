# Database
# When running locally (go run): use localhost
# When running via Docker Compose: use host=postgres ...
DATABASE_URL=host=localhost port=5432 user=postgres password=yourpassword dbname=appdb sslmode=disable

# Session
SESSION_SECRET=replace-with-a-long-random-secret

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# LLM (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# System prompt sent to the LLM
SYSTEM_PROMPT=You are a helpful assistant.

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
