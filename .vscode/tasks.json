{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run all with Docker",
      "type": "shell",
      "command": "docker compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "go run main.go",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run All",
      "dependsOn": [
        "Run API",
        "Run Frontend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Rebuild Go and run",
      "type": "shell",
      "command": "docker compose up -d --build api && docker compose logs -f api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Rebuild Go and debug (Delve)",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Recompile Go and restart Delve",
      "type": "shell",
      "command": "docker exec gomodule1-api-1 sh -c \"kill -9 \$(pgrep dlv) 2>/dev/null; CGO_ENABLED=0 GOOS=linux go build -gcflags='all=-N -l' -o server . && dlv exec ./server --listen=:2345 --headless=true --api-version=2 --accept-multiclient --continue &\"",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Open psql",
      "type": "shell",
      "command": "docker exec -it gomodule1-postgres-1 psql -U postgres -d appdb",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "Run Go Tests",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": []
    }
  ]
}