{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Docker (Delve)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "127.0.0.1",
      "substitutePath": [
        {
          "from": "${workspaceFolder}/api",
          "to": "/app"
        }
      ],
      "trace": "log",
      "showLog": true
    }
  ]
}
