FROM golang:1.26-alpine
RUN apk --no-cache add ca-certificates
RUN go install github.com/go-delve/delve/cmd/dlv@latest
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build with debug flags: disable optimizations and inlining
RUN CGO_ENABLED=0 GOOS=linux go build -gcflags="all=-N -l" -o cmd/server ./cmd
EXPOSE 8080 2345
CMD ["sh", "-c", "CGO_ENABLED=0 GOOS=linux go build -gcflags='all=-N -l' -o cmd/server ./cmd && dlv exec ./cmd/server --listen=:2345 --headless=true --api-version=2 --accept-multiclient --continue"]
